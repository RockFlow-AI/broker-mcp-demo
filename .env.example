# ---- 服务自身 ----
# 传输方式：http（默认）或 stdio（本地调试，自动关闭鉴权）
#BROKER_MCP_TRANSPORT=http
#BROKER_MCP_HOST=0.0.0.0
#BROKER_MCP_PORT=8000

# ---- 鉴权（API key）----
# 逗号分隔，每条为 key 或 key:client_id。客户端请求头需携带
# Authorization: Bearer <api-key>
BROKER_MCP_API_KEYS=demo-key-1:alice,demo-key-2:bob

# 仅本地调试：true 时关闭鉴权
#BROKER_MCP_AUTH_DISABLED=false

# ---- 下游券商后端（demo 不内置真实地址，请自行配置）----
# 留空时各工具返回内置示例数据（响应带 "mock": true 标记）
#BROKER_MCP_BACKEND_BASE_URL=https://your-broker-api.example.com
#BROKER_MCP_BACKEND_TIMEOUT=30
